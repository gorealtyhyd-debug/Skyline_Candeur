# Public production URL (canonical, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://skylinebycandeur.in

# Enquiry form — static form service (no server code needed)
# Web3Forms (free): endpoint https://api.web3forms.com/submit + access key from web3forms.com
# Formspree: endpoint https://formspree.io/f/<id> (leave access key empty)
NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Optional: Google Search Console verification token
NEXT_PUBLIC_GSC_VERIFICATION=
